# APKGuard Industrial v3 Phase 3 configuration
APKGUARD_ENVIRONMENT=development
APKGUARD_LOG_LEVEL=INFO
APKGUARD_LOG_FORMAT=text

# Privacy is explicit. Allowed: local_only, hash_only, cloud_enrichment, private_enterprise
APKGUARD_PRIVACY_MODE=local_only
APKGUARD_ALLOW_VT_UPLOAD=false
APKGUARD_DYNAMIC_MODE=disabled

APKGUARD_ENABLE_CACHE=true
APKGUARD_ENABLE_HISTORY=true
APKGUARD_HISTORY_LIMIT=50
APKGUARD_MAX_UPLOAD_MB=100
APKGUARD_MAX_ZIP_ENTRIES=10000
APKGUARD_MAX_UNCOMPRESSED_MB=1024
APKGUARD_MAX_COMPRESSION_RATIO=250
APKGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development uses SQLite + eager execution. Docker Compose overrides these with PostgreSQL + Redis.
APKGUARD_DATABASE_URL=sqlite:///./data/apkguard.db
APKGUARD_AUTO_CREATE_DATABASE=false
APKGUARD_DATABASE_ECHO=false
APKGUARD_QUARANTINE_DIR=./data/quarantine
APKGUARD_QUARANTINE_RETENTION_DAYS=30

APKGUARD_QUEUE_BACKEND=eager
APKGUARD_REDIS_URL=redis://localhost:6379/0
APKGUARD_REDIS_QUEUE=apkguard:scan-jobs
APKGUARD_WORKER_POLL_SECONDS=2
APKGUARD_JOB_TIMEOUT_SECONDS=900
APKGUARD_JOB_MAX_ATTEMPTS=2
APKGUARD_JOB_RETRY_DELAY_SECONDS=1
APKGUARD_STALE_JOB_SECONDS=1800
APKGUARD_ANALYSIS_ISOLATION=inline

# Optional integrations. Leave blank for local-only operation.
VT_API_KEY=
GROQ_API_KEY=
SIEM_WEBHOOK_URL=
SIEM_THRESHOLD=60

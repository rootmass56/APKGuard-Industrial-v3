# APKGuard Sprint 0 configuration
# Core scanner works without these optional API keys.

# Optional: Groq key for AI explanation only. Deterministic analysis remains authoritative.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: VirusTotal hash-only lookup. Unknown file upload is disabled by default.
VT_API_KEY=
APKGUARD_ALLOW_VT_UPLOAD=false

# Local retention controls
APKGUARD_ENABLE_CACHE=true
APKGUARD_ENABLE_HISTORY=true
APKGUARD_MAX_UPLOAD_MB=100

# Frontend development origin. Add production domains explicitly; do not use wildcard in deployment.
APKGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SIEM webhook. Test endpoint refuses to send if this is empty.
SIEM_WEBHOOK_URL=

# Dynamic analysis is disabled in Sprint 0. The industrial target uses an isolated sandbox worker.
APKGUARD_DYNAMIC_MODE=disabled

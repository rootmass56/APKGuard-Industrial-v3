# APKGuard Industrial v3 Phase 4 configuration
APKGUARD_ENVIRONMENT=development
APKGUARD_LOG_LEVEL=INFO
APKGUARD_LOG_FORMAT=text

# Privacy is explicit. Allowed: local_only, hash_only, cloud_enrichment, private_enterprise
APKGUARD_PRIVACY_MODE=local_only
APKGUARD_ALLOW_VT_UPLOAD=false

APKGUARD_ENABLE_CACHE=true
APKGUARD_ENABLE_HISTORY=true
APKGUARD_HISTORY_LIMIT=50
APKGUARD_MAX_UPLOAD_MB=100
APKGUARD_MAX_ZIP_ENTRIES=10000
APKGUARD_MAX_UNCOMPRESSED_MB=1024
APKGUARD_MAX_COMPRESSION_RATIO=250
APKGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development uses SQLite + eager execution. Dynamic execution remains disabled in this mode.
APKGUARD_DATABASE_URL=sqlite:///./data/apkguard.db
APKGUARD_AUTO_CREATE_DATABASE=false
APKGUARD_DATABASE_ECHO=false
APKGUARD_QUARANTINE_DIR=./data/quarantine
APKGUARD_QUARANTINE_RETENTION_DAYS=30

APKGUARD_QUEUE_BACKEND=eager
APKGUARD_REDIS_URL=redis://localhost:6379/0
APKGUARD_REDIS_QUEUE=apkguard:scan-jobs
APKGUARD_WORKER_POLL_SECONDS=2
APKGUARD_JOB_TIMEOUT_SECONDS=1200
APKGUARD_JOB_MAX_ATTEMPTS=2
APKGUARD_JOB_RETRY_DELAY_SECONDS=1
APKGUARD_STALE_JOB_SECONDS=1800
APKGUARD_ANALYSIS_ISOLATION=inline

# Phase 4 isolated Android sandbox. All gates must be deliberately enabled on a dedicated worker host.
APKGUARD_DYNAMIC_MODE=disabled
APKGUARD_SANDBOX_ENABLED=false
APKGUARD_SANDBOX_ACKNOWLEDGE_ISOLATION_RISK=false
APKGUARD_SANDBOX_DEDICATED_HOST=false
APKGUARD_SANDBOX_HOST_EGRESS_BLOCKED=false
APKGUARD_SANDBOX_AVD_NAME=
APKGUARD_SANDBOX_SNAPSHOT=apkguard-clean
APKGUARD_SANDBOX_NETWORK_MODE=offline
APKGUARD_SANDBOX_INSTRUMENTATION=logcat_only
APKGUARD_SANDBOX_ADB_PATH=adb
APKGUARD_SANDBOX_EMULATOR_PATH=emulator
APKGUARD_SANDBOX_FRIDA_PATH=frida
APKGUARD_SANDBOX_EMULATOR_PORT=5556
APKGUARD_SANDBOX_BOOT_TIMEOUT_SECONDS=180
APKGUARD_SANDBOX_EXECUTION_TIMEOUT_SECONDS=240
APKGUARD_SANDBOX_INTERACTION_SECONDS=20
APKGUARD_SANDBOX_MONKEY_EVENTS=50
APKGUARD_SANDBOX_HEADLESS=true
APKGUARD_SANDBOX_CAPTURE_SCREENSHOT=true
APKGUARD_SANDBOX_CAPTURE_LOGCAT=true
APKGUARD_SANDBOX_CAPTURE_NETWORK=true
APKGUARD_SANDBOX_CAPTURE_PROCESSES=true
APKGUARD_SANDBOX_CAPTURE_FILESYSTEM_DIFF=true
APKGUARD_SANDBOX_ALLOW_ADB_ROOT=false
APKGUARD_SANDBOX_WORKER_ID=dedicated-sandbox-worker
APKGUARD_SANDBOX_WORKSPACE_DIR=./data/sandbox_sessions
APKGUARD_SANDBOX_ARTIFACT_RETENTION_DAYS=7
APKGUARD_SANDBOX_MAX_COMMAND_OUTPUT_BYTES=2000000

# Optional integrations. Leave blank for local-only operation.
VT_API_KEY=
GROQ_API_KEY=
SIEM_WEBHOOK_URL=
SIEM_THRESHOLD=60
